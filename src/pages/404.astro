---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for doesn’t exist or has moved." noindex ads={false}>
  <section class="sec" style="min-height:50vh;align-content:center">
    <p class="label">Error 404</p>
    <h1 class="page-title">This page has <em class="s">wandered off</em></h1>
    <p class="lede">The link may be old or mistyped. Try the journal, or head back home.</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <a class="btn btn-dark" href="/">Back to home <span class="ar" aria-hidden="true">→</span></a>
      <a class="btn btn-lime" href="/blog/">Read the journal <span class="ar" aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
