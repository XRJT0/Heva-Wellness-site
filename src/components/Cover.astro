---
/**
 * Post cover. Uses the frontmatter `cover` image when present,
 * otherwise a category-tinted plate so every card still looks finished.
 */
import type { ImageMetadata } from 'astro';
import Media from './Media.astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  position?: string;
  category: string;
  label?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const {
  src,
  alt = '',
  position,
  category,
  label,
  eager = false,
  sizes = '(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 420px',
  class: cls,
} = Astro.props;
---

<div class:list={['cover', `cat-${category}`, { 'has-img': src }, cls]}>
  {src && <Media src={src} alt={alt} sizes={sizes} position={position} eager={eager} />}
  {label && <span class="mono">{label}</span>}
</div>
