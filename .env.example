# Your live domain (no trailing slash). Used for canonical URLs, sitemap, RSS, OG tags.
SITE_URL=https://www.hevawellness.com

# Google AdSense: leave empty until approved (the site stays ad-free and clean for review)
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
PUBLIC_ADSENSE_SLOT_END=
PUBLIC_ADSENSE_SLOT_SIDEBAR=

# true = hide the built-in cookie banner because Google's certified CMP
# (AdSense → Privacy & messaging) is handling consent
PUBLIC_USE_GOOGLE_CMP=false

# Google Analytics 4 (optional), e.g. G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Form endpoints (Formspree, Basin, Netlify Forms, your email provider…)
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_NEWSLETTER_ENDPOINT=
